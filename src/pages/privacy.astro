---
// /privacy/ — what this site actually does with data (2026-11-19, Reelflow task 202611191245 B1).
// Written from the code, not from a template: every service named here is in this repo (src/data/site.ts,
// src/components/Analytics.astro, the Kit forms, the Amazon / Gumroad links). Change this page when one of them changes.
import BaseLayout from "../layouts/BaseLayout.astro";
import { AMAZON_DISCLOSURE, UMAMI_SCRIPT, POSTHOG_HOST } from "../data/site";
const CONTACT = "hello@neuropulsemind.com";
const UPDATED = "November 19, 2026";
const umamiHost = new URL(UMAMI_SCRIPT).hostname;
const posthogHost = new URL(POSTHOG_HOST).hostname;
---

<BaseLayout
  title="Privacy — NeuroPulse"
  description="What neuropulsemind.com collects, which services it uses and why, in plain English."
  canonical="https://neuropulsemind.com/privacy/"
>
  <article class="privacy">
    <p class="privacy__label">Privacy</p>
    <h1>What this site collects, and why</h1>
    <p class="privacy__meta">Last updated {UPDATED}</p>

    <div class="prose">
      <p>
        neuropulsemind.com is run by NeuroPulse, a small team in Amman, Jordan. This page lists every service the site
        uses and what each one sees. If something here is unclear, email <a href={`mailto:${CONTACT}`}>{CONTACT}</a>.
      </p>

      <h2>Reading the site</h2>
      <p>
        You can read every article without giving us anything. We do not use advertising trackers, Google Analytics,
        a Facebook pixel or embedded videos. Our fonts are served from this site, not from Google.
      </p>
      <p>
        <strong>Hosting (Vercel).</strong> The site is hosted by Vercel. Like any web host, Vercel's servers receive
        your IP address and browser details when a page loads, and keep request logs.
      </p>
      <p>
        <strong>Visit counts (Umami).</strong> We count page views with Umami Cloud ({umamiHost}). Umami does not set
        cookies and does not identify you; we see totals such as how many people read a page, their country and type of
        device, and which site sent them (for example a link from Instagram).
      </p>
      <p>
        <strong>Funnel counts (PostHog).</strong> We also send page views and five simple events to PostHog
        ({posthogHost}, PostHog's US cloud): starting the quiz, finishing it (with the result, such as FOG), sending the
        email form, and clicking a link to our $9 guide or to Amazon. PostHog keeps a random ID in your browser's local
        storage (not a cookie) so a visit counts once. It does not record your screen, your keystrokes or your name.
        We read these as weekly totals.
      </p>
      <p>
        Both services see your IP address when your browser sends a count (that is how the internet works) and use it
        to estimate a country. Both only run on neuropulsemind.com. If you block them, the site works the same.
      </p>

      <h2>The quiz</h2>
      <p>
        The quiz is scored in your browser. Your answers are not sent anywhere. The result (FOG, MEMORY or ENERGY) is
        saved in your browser's local storage so the thank-you page can show the right guide. You can clear it by
        clearing this site's data in your browser.
      </p>

      <h2>Your email (Kit)</h2>
      <p>
        If you type your email into one of our forms, it goes straight to Kit (app.kit.com), the service that sends our
        emails. Kit stores your email address, the date you signed up, and, if you came from the quiz, your quiz result and the
        fact that you came from the quiz.
        We only use your email to send the guide and our emails. We do not sell it or share it with anyone else.
      </p>
      <p>
        Every email has an unsubscribe link at the bottom; one click and you get no more emails. Kit, like most email
        services, can record when an email is opened or a link in it is clicked.
      </p>
      <p>
        To see what we hold about you, or to have your email deleted, write to <a href={`mailto:${CONTACT}`}>{CONTACT}</a>
        from that address.
      </p>

      <h2>Buying the $9 guide (Gumroad)</h2>
      <p>
        The NeuroPulse Protocol is sold through Gumroad. Payment and your card details are handled by Gumroad, not by
        us. Gumroad shares your email (and your name, if you give it) with us so we can send the product and handle
        refunds.
      </p>

      <h2>Amazon links</h2>
      <p>
        {AMAZON_DISCLOSURE} When you click one of our Amazon links, Amazon may set its own cookies. If you buy something,
        Amazon tells us that an item was ordered so it can pay us a small commission; it does not tell us who you are.
      </p>

      <h2>Links to studies</h2>
      <p>
        Our articles link to the papers they describe (PubMed, journal websites). Those sites have their own privacy
        rules. We do not send them anything about you.
      </p>

      <h2>Changes</h2>
      <p>
        When we add or remove a service, we change this page and its date.
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .privacy { max-width: var(--measure); margin: 0 auto; padding: 2.5rem 16px 3.5rem; }
  .privacy__label { font-size: 0.875rem; font-weight: 650; color: var(--amber); margin: 0 0 0.5rem; }
  .privacy h1 { font-size: var(--step-3); margin: 0 0 0.5rem; }
  .privacy__meta { font-size: 0.875rem; color: var(--text-dim); margin: 0 0 1.8rem; }
  .privacy .prose h2 { font-size: var(--step-1); }
</style>
