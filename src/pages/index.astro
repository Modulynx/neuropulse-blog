---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import LeadMagnet from '../components/LeadMagnet.astro';

const allPosts = await getCollection('blog', ({ data }) => {
  return data.draft !== true;
});

// Sort by pubDate descending
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="NeuroPulse - Neuroscience & Cognitive Optimization">
  
  <section class="hero">
    <div class="hero-content">
      <span class="label">NeuroPulse · Brain Science for Real American Life 🇺🇸</span>
      <h1>Your Brain Wasn't Built for This</h1>
      <p class="tagline">
        The dopamine hits, the 3am scrolling, the Monday exhaustion — there's neuroscience behind all of it. We break it down, no jargon, no fluff.
      </p>
    </div>
  </section>

  <main class="container">
    <div class="grid">
      {sortedPosts.map(post => (
        <ArticleCard 
          slug={post.id}
          title={post.data.title}
          description={post.data.description}
          niche={post.data.niche}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          heroImage={post.data.heroImage}
        />
      ))}
    </div>

    <div class="lead-magnet-wrapper">
      <LeadMagnet />
    </div>
  </main>
</BaseLayout>

<style>
  .hero {
    padding: clamp(3rem, 8vw, 6rem) 1.5rem clamp(2.5rem, 6vw, 4rem);
    text-align: center;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .hero-content {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  /* Simple editorial label — no glowing pill */
  .label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--amber);
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--text);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .tagline {
    font-size: clamp(1rem, 2.5vw, 1.15rem);
    color: var(--text-dim);
    max-width: 560px;
    line-height: 1.7;
    margin: 0;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 4rem) 1.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .lead-magnet-wrapper {
    margin-top: 3rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border);
  }
</style>

