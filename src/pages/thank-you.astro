---
// thank-you.astro — post-subscribe confirmation page.
// Kit's Form Settings → Success message → Redirect to URL should point
// here after a successful subscription (see the comment in LeadMagnet.astro).
// One upsell only: the $9 Protocol. No second offer, no exit-intent popup —
// a reader who just subscribed is warm, not to be worked twice on one page.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="You're in! — NeuroPulse"
  description="Thanks for subscribing to NeuroPulse. Check your inbox for your free guide."
>
  <section class="confirm">
    <div class="confirm__inner">
      <div class="confirm__mark" aria-hidden="true">✓</div>
      <p class="eyebrow">// subscription confirmed</p>
      <h1 class="confirm__title">Here is your Manual</h1>
      <p class="confirm__copy">
        You're officially on the list. Click below to download your copy of The Brain Owner's Manual and start rewiring your daily habits.
      </p>

      <a class="download-btn" href="/brain-owners-manual.pdf" download>
        Download PDF (1.3 MB) ↓
      </a>

      <div class="upsell" aria-label="The NeuroPulse Protocol">
        <div class="upsell__mark" aria-hidden="true">▹</div>
        <div class="upsell__body">
          <p class="upsell__eyebrow">// ready to go deeper?</p>
          <h2 class="upsell__title">The NeuroPulse Protocol</h2>
          <p class="upsell__copy">
            The free guide gives you the science. The NeuroPulse Protocol
            turns it into a daily routine you actually follow — $9,
            instant download, 30-day guarantee.
          </p>
          <a class="upsell__btn" href="/protocol/">See the Protocol — $9 →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .confirm {
    min-height: 60vh;
    display: flex;
    align-items: center;
    padding: 5rem 1.5rem;
    background: radial-gradient(ellipse 70% 60% at 50% 0%, rgba(76, 224, 210, 0.07) 0%, transparent 70%);
  }
  .confirm__inner {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }
  .confirm__mark {
    width: 64px;
    height: 64px;
    margin: 0 auto 1.5rem;
    border-radius: 50%;
    background: rgba(76, 224, 210, 0.1);
    border: 2px solid rgba(76, 224, 210, 0.35);
    color: var(--cyan);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    font-weight: 900;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--cyan);
    letter-spacing: 0.06em;
    margin: 0 0 0.75rem;
  }
  .confirm__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 900;
    color: var(--text);
    margin: 0 0 1.25rem;
  }
  .confirm__copy {
    color: var(--text-dim);
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0 0 2rem;
  }

  .download-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    color: #050810;
    background: var(--cyan);
    text-decoration: none;
    padding: 1rem 2rem;
    border-radius: 12px;
    margin-bottom: 3.5rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 4px 20px rgba(76, 224, 210, 0.2);
  }
  .download-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 25px rgba(76, 224, 210, 0.3);
  }

  /* Single upsell — violet, matches ProtocolCallout's product accent */
  .upsell {
    display: flex;
    gap: 1rem;
    text-align: left;
    background: linear-gradient(180deg, var(--bg-elev-2), var(--bg-elev));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.75rem;
    position: relative;
    overflow: hidden;
  }
  .upsell::before {
    content: "";
    position: absolute; inset: 0 auto 0 0; width: 3px;
    background: var(--violet);
  }
  .upsell__mark {
    font-family: var(--font-mono);
    color: var(--violet);
    font-size: 1.4rem;
    line-height: 1;
    padding-top: 0.2rem;
  }
  .upsell__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--violet);
    letter-spacing: 0.06em;
    margin: 0 0 0.4rem;
  }
  .upsell__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--text);
    margin: 0 0 0.5rem;
  }
  .upsell__copy {
    color: var(--text-dim);
    font-size: var(--step--1);
    line-height: 1.7;
    margin: 0 0 1.1rem;
  }
  .upsell__btn {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step--1);
    color: #fff;
    text-decoration: none;
    background: var(--magenta);
    padding: 0.75rem 1.4rem;
    border-radius: 10px;
    transition: filter 0.15s ease;
  }
  .upsell__btn:hover { filter: brightness(1.08); }

  @media (max-width: 480px) {
    .upsell { flex-direction: column; }
  }
</style>
