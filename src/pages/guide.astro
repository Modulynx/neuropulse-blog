---
// guide.astro — Lead Magnet squeeze page.
// Primary entry point for all social media traffic (Link in Bio).
// Form posts directly to Kit (form 9647814).

import BaseLayout from '../layouts/BaseLayout.astro';

const KIT_ACTION = "https://app.kit.com/forms/9647814/subscriptions";

// The 3 switches of the NeuroPulse Diagnostic (same as /quiz and the $9 Protocol). No "reverse" or
// "peer-reviewed" claims here: this page makes no promise the guide does not keep (manager 2026-09-28).
const benefits = [
  { icon: "🌫️", title: "FOG — the sleep-timing switch", copy: "Thinking through static by mid-afternoon? Often the lever is sleep timing and depth, not willpower." },
  { icon: "🧩", title: "MEMORY — the encoding + stress switch", copy: "Things just don't stick? It feels like focus, but the root is usually stress plus how you take things in." },
  { icon: "🔋", title: "ENERGY — the body-load switch", copy: "Wired but tired? Here steadier basics — sleep, food, easy movement — beat more intensity." },
];
---

<BaseLayout
  title="Free Brain Guide: FOG, MEMORY or ENERGY? — NeuroPulse"
  description="Foggy, forgetful or wired-but-tired? Find which of your 3 brain switches is off — FOG, MEMORY or ENERGY — with a 60-second quiz, then get the free Brain Owner’s Manual."
>
  <section class="hero" id="capture">
    <div class="hero__grid wrap">
      <div class="hero__copy">
        <p class="eyebrow">// free guide — no credit card</p>
        <h1>Your brain didn't come with an <span class="accent">instruction manual</span>. This is one.</h1>
        <p class="lede">Three brain switches — FOG, MEMORY and ENERGY — explained in plain English. Start with the 60-second quiz to see which one is yours, then get the free guide.</p>
        <a class="btn-quiz" href="/quiz/?utm_source=guide">Find my switch — 60-second quiz →</a>
        <p class="micro">Or just send me the free guide:</p>
        <form class="capture-form" action={KIT_ACTION} method="POST">
          <input type="email" name="email_address" placeholder="your@email.com" required autocomplete="email" aria-label="Email address" />
          <button type="submit" class="btn-cta">Send me the free guide →</button>
        </form>
        <p class="micro">No spam. Unsubscribe in one click, anytime.</p>
      </div>
      <div class="hero__visual" aria-hidden="true">
        <div class="brain-diagram">
          <div class="brain-ring ring-1"></div>
          <div class="brain-ring ring-2"></div>
          <div class="brain-ring ring-3"></div>
          <div class="brain-core"><span>🧠</span></div>
          <div class="brain-label label-a">prefrontal cortex</div>
          <div class="brain-label label-b">amygdala</div>
          <div class="brain-label label-c">dopamine pathway</div>
        </div>
      </div>
    </div>
  </section>

  <section class="inside">
    <div class="wrap">
      <p class="eyebrow center">// inside the guide</p>
      <h2 class="section-title center">3 switches. One place to start.</h2>
      <div class="benefits-grid">
        {benefits.map((b) => (
          <div class="benefit-card">
            <div class="benefit-icon">{b.icon}</div>
            <h3 class="benefit-title">{b.title}</h3>
            <p class="benefit-copy">{b.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <section class="bottom-cta">
    <div class="wrap bottom-cta__inner">
      <p class="eyebrow center">// it's free. get it now.</p>
      <h2 class="section-title center">Ready to understand your brain?</h2>
      <form class="capture-form capture-form--center" action={KIT_ACTION} method="POST">
        <input type="email" name="email_address" placeholder="your@email.com" required autocomplete="email" aria-label="Email address" />
        <button type="submit" class="btn-cta">Send me the free guide →</button>
      </form>
      <p class="micro center">No spam. Unsubscribe in one click, anytime.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .wrap { max-width: 1100px; margin-inline: auto; padding-inline: 1.5rem; }
  .center { text-align: center; }
  .eyebrow { font-family: var(--font-mono); font-size: var(--step--1); color: var(--cyan); letter-spacing: 0.08em; margin: 0 0 0.75rem; display: block; }
  .section-title { font-family: var(--font-display); font-size: var(--step-2); font-weight: 700; color: var(--text); margin: 0 0 2.5rem; }
  .accent { color: var(--cyan); }
  .btn-quiz { display: inline-block; margin: 0 0 1.4rem; padding: 0.95rem 1.6rem; background: var(--magenta); color: #fff; font-family: var(--font-display); font-weight: 600; font-size: var(--step-0); border-radius: 10px; text-decoration: none; }
  .btn-quiz:hover { filter: brightness(1.1); }

  .hero { padding: 5rem 0 4rem; background: radial-gradient(ellipse 70% 60% at 60% 40%, rgba(76,224,210,0.06) 0%, transparent 70%), linear-gradient(rgba(76,224,210,0.04) 1px, transparent 1px) 0 0 / 44px 44px, linear-gradient(90deg, rgba(76,224,210,0.04) 1px, transparent 1px) 0 0 / 44px 44px; }
  .hero__grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 3rem; align-items: center; }
  @media (max-width: 768px) { .hero__grid { grid-template-columns: 1fr; } .hero__visual { display: none; } }
  .hero h1 { font-family: var(--font-display); font-size: clamp(2.2rem, 5vw, 3.4rem); font-weight: 700; line-height: 1.08; letter-spacing: -0.02em; color: var(--text); margin: 0 0 1.25rem; }
  .lede { color: var(--text-dim); font-size: var(--step-0); max-width: 52ch; margin: 0 0 2rem; line-height: 1.7; }

  .capture-form { display: flex; gap: 0.6rem; flex-wrap: wrap; max-width: 480px; }
  .capture-form--center { margin-inline: auto; justify-content: center; }
  .capture-form input[type="email"] { flex: 1 1 240px; min-width: 0; padding: 0.85rem 1rem; background: var(--bg-elev); border: 1px solid var(--border); border-radius: 10px; color: var(--text); font-family: var(--font-body); font-size: var(--step-0); transition: border-color 0.15s; }
  .capture-form input[type="email"]:focus { outline: none; border-color: var(--cyan); }
  .capture-form input[type="email"]::placeholder { color: var(--text-dim); opacity: 0.6; }
  .btn-cta { flex: 0 0 auto; padding: 0.85rem 1.5rem; background: var(--magenta); color: #fff; font-family: var(--font-display); font-size: var(--step-0); font-weight: 600; border: none; border-radius: 10px; cursor: pointer; white-space: nowrap; transition: filter 0.15s, transform 0.1s; }
  .btn-cta:hover { filter: brightness(1.1); }
  .btn-cta:active { transform: translateY(1px); }
  .micro { font-family: var(--font-mono); font-size: var(--step--1); color: var(--text-dim); opacity: 0.55; margin: 0.75rem 0 0; }

  .hero__visual { display: flex; align-items: center; justify-content: center; }
  .brain-diagram { position: relative; width: 280px; height: 280px; display: flex; align-items: center; justify-content: center; }
  .brain-ring { position: absolute; border-radius: 50%; border: 1px solid rgba(76,224,210,0.18); animation: pulse 4s ease-in-out infinite; }
  .ring-1 { width: 100%; height: 100%; }
  .ring-2 { width: 70%; height: 70%; border-color: rgba(76,224,210,0.28); animation-delay: 0.8s; }
  .ring-3 { width: 44%; height: 44%; border-color: rgba(76,224,210,0.45); animation-delay: 1.6s; }
  @keyframes pulse { 0%, 100% { opacity: 0.5; transform: scale(1); } 50% { opacity: 1; transform: scale(1.03); } }
  .brain-core { position: relative; z-index: 2; font-size: 3.5rem; filter: drop-shadow(0 0 16px rgba(76,224,210,0.5)); }
  .brain-label { position: absolute; font-family: var(--font-mono); font-size: 0.7rem; color: var(--cyan); opacity: 0.6; white-space: nowrap; }
  .label-a { top: 12%; left: 60%; }
  .label-b { bottom: 22%; right: 8%; }
  .label-c { bottom: 10%; left: 10%; }

  .inside { padding: 5rem 0; background: linear-gradient(180deg, transparent 0%, rgba(76,224,210,0.03) 50%, transparent 100%); }
  .benefits-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; }
  .benefit-card { background: var(--bg-elev); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.75rem 1.5rem; border-top: 2px solid var(--cyan); transition: border-top-color 0.2s; }
  .benefit-card:hover { border-top-color: var(--magenta); }
  .benefit-icon { font-size: 1.8rem; margin-bottom: 0.75rem; }
  .benefit-title { font-family: var(--font-display); font-size: var(--step-0); font-weight: 600; color: var(--text); margin: 0 0 0.5rem; }
  .benefit-copy { color: var(--text-dim); font-size: var(--step--1); line-height: 1.65; margin: 0; }


  .bottom-cta { padding: 5rem 0 6rem; background: radial-gradient(ellipse 60% 50% at 50% 100%, rgba(76,224,210,0.06) 0%, transparent 70%); }
  .bottom-cta__inner { max-width: 640px; margin-inline: auto; }

  /* ── Form highlight animation when CTA is clicked ── */
  @keyframes form-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(76,224,210,0); border-color: var(--border); }
    30%  { box-shadow: 0 0 0 8px rgba(76,224,210,0.25); border-color: var(--cyan); }
    60%  { box-shadow: 0 0 0 16px rgba(76,224,210,0.08); border-color: var(--cyan); }
    100% { box-shadow: 0 0 0 0 rgba(76,224,210,0); border-color: var(--cyan); }
  }
  .capture-form--highlight input[type="email"] {
    animation: form-pulse 0.9s ease forwards;
  }
</style>

<script>
  // When the page loads with #capture hash OR user clicks the navbar CTA
  // while already on the guide page → highlight the form + focus input
  function activateForm() {
    const form = document.querySelector('.capture-form');
    const input = document.querySelector('.capture-form input[type="email"]');
    if (!form || !input) return;

    // Add highlight class to trigger animation
    form.classList.add('capture-form--highlight');

    // Remove after animation ends so it can re-trigger
    form.addEventListener('animationend', () => {
      form.classList.remove('capture-form--highlight');
    }, { once: true });

    // Focus the input so user can start typing immediately
    input.focus();
  }

  // Trigger on page load if #capture is in URL
  if (window.location.hash === '#capture') {
    // Small delay to ensure scroll has settled
    setTimeout(activateForm, 350);
  }

  // Also intercept navbar CTA clicks while on /guide/
  document.addEventListener('click', (e) => {
    const link = e.target.closest('a[href="/guide/#capture"]');
    if (link && window.location.pathname === '/guide/') {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
      setTimeout(activateForm, 400);
    }
  });
</script>
