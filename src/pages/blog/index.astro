---
// blog/index.astro — every article, newest first, as a plain list (design refresh 2026-11-17).
import { getCollection } from "astro:content";
import { isListed } from "../../utils/listed";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";

const posts = (await getCollection("blog", isListed)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="All articles · NeuroPulse"
  description="Every NeuroPulse article: one brain study at a time, explained plainly, with a link to the paper."
  canonical="https://neuropulsemind.com/blog/"
>
  <div class="wrap">
    <header class="head">
      <h1>All articles</h1>
      <p>{posts.length} article{posts.length === 1 ? "" : "s"}, newest first. Each one explains a single study and links to it.</p>
    </header>
    {posts.length === 0 ? <p>First articles are on their way.</p> : <PostList posts={posts} />}
  </div>
</BaseLayout>

<style>
  .wrap { max-width: 760px; margin: 0 auto; padding: clamp(1.75rem, 5vw, 3.5rem) 16px clamp(3rem, 8vw, 5rem); }
  .head { margin-bottom: 1.5rem; }
  .head h1 { font-size: var(--step-3); margin: 0 0 0.5rem; font-weight: 700; }
  .head p { margin: 0; color: var(--text-dim); }
</style>
