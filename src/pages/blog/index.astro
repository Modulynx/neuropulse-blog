---
// blog/index.astro — the /blog landing grid
import "../../styles/global.css";
import { getCollection } from "astro:content";
import ArticleCard from "../../components/ArticleCard.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { estimateReadingMinutes } from "../../utils/readingTime";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const total = posts.length;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>The NeuroPulse Field Notes · Neuroscience, in plain English</title>
    <meta
      name="description"
      content="Short, science-backed reads on how everyday moments shape your brain — focus, sleep, stress, and attention, explained simply."
    />
    <link rel="canonical" href="https://neuropulsemind.com/blog/" />
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <link rel="apple-touch-icon" href="/favicon.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=Inter:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <Navbar />
    <main class="wrap">
      <header class="masthead">
        <span class="masthead__kicker">NeuroPulse Field Notes</span>
        <h1 class="masthead__title">How everyday moments rewire your brain</h1>
        <p class="masthead__sub">
          Short, science-backed reads on focus, sleep, stress, and attention —
          the neuroscience behind the ordinary, explained in plain English.
        </p>
        <p class="masthead__count">{total} article{total === 1 ? "" : "s"}</p>
      </header>

      {total === 0 ? (
        <p class="empty">First articles are on their way. Check back shortly.</p>
      ) : (
        <section class="grid" aria-label="Articles">
          {posts.map((post) => (
            <ArticleCard
              title={post.data.title}
              slug={post.id}
              description={post.data.description}
              niche={post.data.niche}
              pubDate={post.data.pubDate}
              tags={post.data.tags}
              heroImage={post.data.heroImage}
              readingTime={estimateReadingMinutes(post.body ?? "")}
            />
          ))}
        </section>
      )}
    </main>
    <Footer />
  </body>
</html>

<style>
  .wrap {
    max-width: 1120px;
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 3.5rem) 1.25rem clamp(3rem, 8vw, 5rem);
    overflow-x: hidden;
  }

  .masthead {
    max-width: 44ch;
    margin-bottom: 2.5rem;
  }

  /* Warm amber label — no code-style prefix */
  .masthead__kicker {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--amber);
    margin: 0 0 0.85rem;
  }

  /* Playfair Display — editorial, not AI */
  .masthead__title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.15;
    margin: 0 0 1rem;
    color: var(--text);
  }

  .masthead__sub {
    color: var(--text-dim);
    font-size: var(--step-0);
    line-height: 1.7;
    margin: 0 0 1rem;
  }

  .masthead__count {
    font-family: var(--font-body);
    font-size: var(--step--1);
    color: var(--text-dim);
    margin: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 1.4rem;
  }

  .empty {
    color: var(--text-dim);
    font-family: var(--font-body);
  }
</style>
