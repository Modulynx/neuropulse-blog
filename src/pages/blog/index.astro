---
// index.astro — the /blog landing grid.
// Pulls all non-draft posts, sorts newest-first, renders the card grid.
import "../../styles/global.css";
import { getCollection } from "astro:content";
import ArticleCard from "../../components/ArticleCard.astro";
import { estimateReadingMinutes } from "../../utils/readingTime";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const SITE = "NeuroPulse";
const total = posts.length;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>The NeuroPulse Field Notes · Neuroscience, in plain English</title>
    <meta
      name="description"
      content="Short, science-backed reads on how everyday moments shape your brain — focus, sleep, stress, and attention, explained simply."
    />
    <link rel="canonical" href="https://neuropulse.example/blog/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <main class="wrap">
      <header class="masthead">
        <p class="masthead__kicker">// {SITE} field notes</p>
        <h1 class="masthead__title">How everyday moments rewire your brain</h1>
        <p class="masthead__sub">
          Short, science-backed reads on focus, sleep, stress, and attention —
          the neuroscience behind the ordinary, explained in plain English.
        </p>
        <p class="masthead__count">{total} article{total === 1 ? "" : "s"}</p>
      </header>

      {total === 0 ? (
        <p class="empty">First articles are on their way. Check back shortly.</p>
      ) : (
        <section class="grid" aria-label="Articles">
          {posts.map((post) => (
            <ArticleCard
              title={post.data.title}
              slug={post.id}
              description={post.data.description}
              niche={post.data.niche}
              pubDate={post.data.pubDate}
              tags={post.data.tags}
              heroImage={post.data.heroImage}
              readingTime={estimateReadingMinutes(post.body ?? "")}
            />
          ))}
        </section>
      )}
    </main>
  </body>
</html>

<style>
  .wrap { max-width: 1120px; margin-inline: auto; padding: 3.5rem 1.25rem 5rem; }

  .masthead { max-width: 40ch; margin-bottom: 3rem; }
  .masthead__kicker {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--cyan);
    letter-spacing: 0.08em;
    margin: 0 0 0.9rem;
  }
  .masthead__title { font-size: var(--step-3); line-height: 1.1; margin: 0 0 1rem; }
  .masthead__sub { color: var(--text-dim); font-size: var(--step-0); margin: 0 0 1.2rem; }
  .masthead__count { font-family: var(--font-mono); font-size: var(--step--1); color: var(--text-dim); margin: 0; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.4rem;
  }

  .empty { color: var(--text-dim); font-family: var(--font-mono); }

  @media (max-width: 640px) {
    .wrap { padding-top: 2.5rem; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
