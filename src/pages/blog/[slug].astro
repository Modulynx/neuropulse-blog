---
// blog/[slug].astro — one article (design refresh 2026-11-17).
// Order: date + reading time, title, standfirst, byline, hero (full width, caption), "The study" card, the text
// (its "What this study can't tell us" section becomes a note, see src/utils/rehypeLimits.mjs), Sources,
// affiliate disclosure (only when the text has an Amazon link), the about box, the free guide, 2 related articles.
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import LeadMagnet from '../../components/LeadMagnet.astro';
import StudyCard from '../../components/StudyCard.astro';
import AboutBox from '../../components/AboutBox.astro';
import PostList from '../../components/PostList.astro';
import { estimateReadingMinutes } from '../../utils/readingTime';
import { imageSize } from '../../utils/imageSize';
import { collectSources, hasAmazonLink } from '../../utils/sources';
import { AMAZON_DISCLOSURE } from '../../data/site';

// The old posts carry a generic glowing-brain hero with no caption. Only OUR stills with a caption are shown
// (scripts/blog_images.js in Reelflow writes heroCaption). ROLLBACK (one line): true = every heroImage is shown again.
const SHOW_UNCAPTIONED_HERO = false;

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const formattedDate = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' }).format(d.pubDate);
const readingMinutes = estimateReadingMinutes(entry.body ?? '');

const showHero = !!d.heroImage && (!!d.heroCaption || SHOW_UNCAPTIONED_HERO);
const heroDims = showHero ? (imageSize(d.heroImage) ?? { width: 1200, height: 675 }) : null;
const heroAlt = d.heroAlt || d.heroCaption || '';
// our video stills are portrait (9:16): the hero shows a 3:2 crop around the upper part (the face), the file stays whole
const heroPortrait = !!heroDims && heroDims.height > heroDims.width;

const sources = collectSources(entry.body ?? '', d.study);
const amazon = hasAmazonLink(entry.body ?? '');

// 2 related articles: shared tags first, then the newest others
const others = (await getCollection('blog', ({ data }) => !data.draft)).filter((p) => p.id !== entry.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const tagSet = new Set(d.tags);
const score = (p: any) => p.data.tags.filter((t: string) => tagSet.has(t)).length;
const related = [...others].sort((a, b) => score(b) - score(a)).slice(0, 2);
---

<ArticleLayout
  title={d.title}
  description={d.description}
  slug={entry.id}
  author={d.author}
  pubDate={d.pubDate}
  tags={d.tags}
  image={showHero ? d.heroImage : undefined}
  citation={d.study ? { title: d.study.title, url: d.study.url } : undefined}
>
  <main class="art">
    <article>
      <header class="art__head">
        <p class="art__meta"><time datetime={d.pubDate.toISOString()}>{formattedDate}</time> · {readingMinutes} min read</p>
        <h1 class="art__title">{d.title}</h1>
        {d.description && <p class="art__dek">{d.description}</p>}
        <p class="art__by">By <a href="#about-neuropulse">NeuroPulse</a></p>
      </header>

      {showHero && heroDims && (
        <figure class:list={["art__hero", "np-figure", { "art__hero--portrait": heroPortrait }]}>
          <img src={d.heroImage} alt={heroAlt} width={heroDims.width} height={heroDims.height} loading="eager" fetchpriority="high" decoding="async" />
          {d.heroCaption && <figcaption>{d.heroCaption}</figcaption>}
        </figure>
      )}

      <div class="art__body">
        {d.study && <StudyCard study={d.study} />}
        <div class="prose">
          <Content />
        </div>

        {sources.length > 0 && (
          <section class="art__sources" aria-labelledby="sources-h">
            <h2 id="sources-h">Sources</h2>
            <ol>
              {sources.map((s) => <li><a href={s.url} rel="noopener">{s.label}</a></li>)}
            </ol>
          </section>
        )}

        {amazon && <p class="art__disclosure">{AMAZON_DISCLOSURE} Links to Amazon in this article are affiliate links.</p>}

        <AboutBox />
      </div>
    </article>

    <div class="art__guide">
      <LeadMagnet />
    </div>

    {related.length > 0 && (
      <section class="art__related" aria-labelledby="related-h">
        <h2 id="related-h" class="art__related-h">Read next</h2>
        <PostList posts={related} headingLevel={3} />
      </section>
    )}
  </main>
</ArticleLayout>

<style>
  .art { padding: clamp(1.75rem, 5vw, 3.5rem) 16px clamp(3rem, 8vw, 5rem); }
  .art__head, .art__body, .art__guide, .art__related { max-width: var(--measure); margin-inline: auto; }
  .art__meta { margin: 0 0 0.75rem; font-size: 0.875rem; color: var(--text-dim); }
  .art__title { font-size: var(--step-3); line-height: 1.12; margin: 0 0 0.9rem; font-weight: 700; }
  .art__dek { margin: 0 0 1rem; font-family: var(--font-serif); font-size: clamp(1.15rem, 1.05rem + 0.4vw, 1.3rem); line-height: 1.5; color: var(--text-dim); }
  .art__by { margin: 0 0 1.75rem; font-size: 0.9375rem; color: var(--text-dim); }
  .art__by a { color: var(--text); font-weight: 600; }

  .art__hero { max-width: 1040px; margin: 0 auto 2rem; }
  .art__hero img { display: block; width: 100%; height: auto; border-radius: var(--radius); background: var(--bg-elev); }
  .art__hero--portrait img { aspect-ratio: 3 / 2; object-fit: cover; object-position: 50% 28%; }
  .art__hero figcaption { max-width: var(--measure); margin-inline: auto; }

  .art__sources { margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid var(--border); font-size: 0.9375rem; line-height: 1.5; }
  .art__sources h2 { font-family: var(--font-body); font-size: 0.9375rem; font-weight: 650; margin: 0 0 0.5rem; }
  .art__sources ol { margin: 0; padding-left: 1.25rem; }
  .art__sources li { margin-bottom: 0.4rem; overflow-wrap: anywhere; }
  .art__disclosure { margin: 1.25rem 0 0; font-size: 0.875rem; color: var(--text-dim); }

  .art__guide { margin-top: 3rem; }
  .art__related { margin-top: 3rem; }
  .art__related-h { font-family: var(--font-body); font-size: 0.9375rem; font-weight: 650; margin: 0 0 0.25rem; }
</style>
