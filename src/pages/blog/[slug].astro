---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import LeadMagnet from '../../components/LeadMagnet.astro';
import ProtocolCallout from '../../components/ProtocolCallout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { estimateReadingMinutes } from '../../utils/readingTime';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Format date
const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(entry.data.pubDate);

// Reading time (Task 7) — estimated from the raw markdown body, ~200wpm
const readingMinutes = estimateReadingMinutes(entry.body ?? '');

// Related Field Notes (Task 6) — other published posts sharing at least
// one tag, newest first, capped at 3. Section is omitted entirely if none.
const currentTags = new Set(entry.data.tags);
const relatedPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((p) => p.id !== entry.id)
  .filter((p) => p.data.tags.some((tag) => currentTags.has(tag)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  slug={entry.id}
  author={entry.data.author}
  pubDate={entry.data.pubDate}
  tags={entry.data.tags}
>
  <div class="article-grid">
    <article class="post-container">
      <header class="post-header">
        <div class="meta">
          <span class="niche">{entry.data.niche || 'Neuroscience'}</span>
          <span class="dot">•</span>
          <time datetime={entry.data.pubDate.toISOString()}>{formattedDate}</time>
          <span class="dot">•</span>
          <span class="reading-time">// {readingMinutes} min read</span>
        </div>

        <h1>{entry.data.title}</h1>

        <p class="description">{entry.data.description}</p>

        <div class="author-info">
          <div class="avatar">EC</div>
          <div class="author-details">
            <span class="name">{entry.data.author}</span>
            <div class="tags">
              {entry.data.tags.map(tag => (
                <span class="tag">#{tag}</span>
              ))}
            </div>
          </div>
        </div>
      </header>

      <div class="post-content prose">
        <Content />
      </div>
    </article>

    <aside class="article-sidebar" aria-label="Recommended resources">
      <div class="sidebar-sticky">
        <LeadMagnet />
        <ProtocolCallout
          title="Quick Implementation"
          content="Reading about neuroscience is not enough. Implementation is what changes your baseline. Start with the easiest step above and commit to it for 48 hours."
        />
      </div>
    </aside>
  </div>

  {relatedPosts.length > 0 && (
    <section class="related" aria-label="Related field notes">
      <p class="related__eyebrow">// related field notes</p>
      <h2 class="related__title">Keep exploring</h2>
      <div class="related__grid">
        {relatedPosts.map((post) => (
          <ArticleCard
            title={post.data.title}
            slug={post.id}
            description={post.data.description}
            niche={post.data.niche}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            readingTime={estimateReadingMinutes(post.body ?? '')}
          />
        ))}
      </div>
    </section>
  )}
</ArticleLayout>

<style>
  /* Desktop: article + sticky sidebar side by side.
     Mobile (<768px): single column, sidebar content stacks below the
     article since it's the second element in source order. */
  .article-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 340px);
    align-items: start;
    gap: 3rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 2rem 3rem;
  }

  .article-sidebar {
    min-width: 0;
  }

  .sidebar-sticky {
    position: sticky;
    top: 88px; /* clears the 64px sticky navbar + breathing room */
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .post-container {
    max-width: 800px;
    width: 100%;
    min-width: 0;
  }

  .post-header {
    margin-bottom: 3rem;
  }

  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--text-dim);
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .niche {
    color: var(--cyan);
    font-weight: 600;
  }

  .dot {
    color: rgba(255, 255, 255, 0.2);
  }

  .reading-time {
    font-family: var(--font-mono);
    color: var(--text-dim);
  }

  h1 {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--text);
    margin: 0 0 1.5rem 0;
  }

  .description {
    font-size: 1.25rem;
    color: var(--text-dim);
    line-height: 1.6;
    margin-bottom: 2rem;
    border-left: 3px solid var(--cyan);
    padding-left: 1rem;
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(76, 224, 210, 0.1);
    color: var(--cyan);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 1.125rem;
    border: 1px solid rgba(76, 224, 210, 0.2);
  }

  .author-details {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .name {
    font-weight: 600;
    color: var(--text);
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  /* Prose Styling */
  .prose {
    color: var(--text);
    line-height: 1.8;
    font-size: 1.125rem;
  }

  .prose :global(h2) {
    font-size: 2rem;
    color: var(--text);
    margin-top: 3rem;
    margin-bottom: 1rem;
  }

  .prose :global(h3) {
    font-size: 1.5rem;
    color: var(--text);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose :global(p) {
    margin-bottom: 1.5rem;
  }

  .prose :global(ul) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .prose :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose :global(strong) {
    color: var(--cyan);
  }

  /* Related Field Notes */
  .related {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 2rem 5rem;
    border-top: 1px solid var(--border);
  }

  .related__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--cyan);
    letter-spacing: 0.06em;
    margin: 0 0 0.6rem;
  }

  .related__title {
    font-size: var(--step-2);
    margin: 0 0 1.5rem;
  }

  .related__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.4rem;
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 2.25rem;
    }

    .article-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding: 2.5rem 1.25rem 2.5rem;
    }

    .sidebar-sticky {
      position: static;
      top: auto;
    }

    .related {
      padding: 2.5rem 1.25rem 3.5rem;
    }

    .related__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
