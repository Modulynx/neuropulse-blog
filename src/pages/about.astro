---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadMagnet from '../components/LeadMagnet.astro';
---

<BaseLayout
  title="About — NeuroPulse"
  description="NeuroPulse translates cutting-edge neuroscience research into practical daily habits. Meet Ethan Cole, neuroscience writer and educator."
>
  <!-- ── HERO ─────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero__inner">
      <span class="eyebrow">About NeuroPulse</span>
      <h1 class="hero__title">The science of a calmer mind</h1>
      <p class="hero__subtitle">
        NeuroPulse exists for one reason: to close the gap between what
        neuroscience knows and what people actually do. Most research stays
        locked in journals. We translate it into habits you can start tonight.
      </p>
    </div>
  </section>

  <!-- ── MISSION ───────────────────────────────────────────────── -->
  <section class="section mission">
    <div class="section__inner">
      <span class="eyebrow">Our Mission</span>
      <h2 class="section__title">Why NeuroPulse exists</h2>
      <div class="mission__grid">
        <div class="mission__card">
          <div class="mission__icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          </div>
          <h3>Research-to-habit translation</h3>
          <p>We read the peer-reviewed papers so you don't have to. Every article distils real neuroscience into concrete, repeatable actions — no fluff, no hype.</p>
        </div>
        <div class="mission__card">
          <div class="mission__icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </div>
          <h3>Practical over theoretical</h3>
          <p>Knowing that dopamine depletion causes procrastination is useless unless you know what to do at 9 p.m. on a Tuesday. We give you the what and the why.</p>
        </div>
        <div class="mission__card">
          <div class="mission__icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
          </div>
          <h3>Focused on daily life</h3>
          <p>We cover sleep architecture, attention, stress regulation, and habit formation — the four pillars that shape how well your brain performs in modern life.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── AUTHOR ────────────────────────────────────────────────── -->
  <section class="section author-section">
    <div class="section__inner">
      <span class="eyebrow">Behind the Science</span>
      <h2 class="section__title">Who writes NeuroPulse</h2>
      <div class="author-card">
        <div class="author-card__left">
          <div class="author__avatar">NP</div>
          <div class="author__meta">
            <span class="author__name">The NeuroPulse Team</span>
            <span class="author__role">Neuroscience Writers &amp; Researchers</span>
          </div>
        </div>
        <div class="author-card__bio">
          <p>NeuroPulse is built by a team at the intersection of cognitive science and practical self-improvement. We watched too many smart people burn out trying to optimise everything at once — so we built NeuroPulse around a simpler premise: understand the mechanism, change one thing at a time.</p>
          <p>Our writing focuses on the biology behind attention, sleep, and stress — not as abstract concepts, but as levers you can actually pull. Every NeuroPulse article starts with a question a real person asked and ends with something you can try before midnight tonight.</p>
          <div class="author__tags">
            <span class="tag">#sleep</span>
            <span class="tag">#dopamine</span>
            <span class="tag">#attention</span>
            <span class="tag">#habits</span>
            <span class="tag">#stress</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── VALUES ────────────────────────────────────────────────── -->
  <section class="section values-section">
    <div class="section__inner values__inner">
      <div class="values__text">
        <span class="eyebrow">What We Believe</span>
        <h2 class="section__title">The NeuroPulse principles</h2>
        <ol class="values__list">
          <li><strong>Cite the mechanism.</strong> Every claim links back to a known neurological process — not just correlation data.</li>
          <li><strong>One habit beats ten tips.</strong> We'd rather you do one thing consistently than feel inspired and do nothing.</li>
          <li><strong>No wellness theatre.</strong> If it sounds soothing but has no evidence, we won't recommend it.</li>
          <li><strong>Dark doesn't mean depressing.</strong> Understanding how your brain defaults to stress is the first step to changing that default — and that's genuinely hopeful.</li>
        </ol>
      </div>
      <div class="values__stat-stack">
        <div class="stat-card">
          <span class="stat__num">3+</span>
          <span class="stat__label">Articles per week</span>
        </div>
        <div class="stat-card">
          <span class="stat__num">100%</span>
          <span class="stat__label">Neuroscience-backed</span>
        </div>
        <div class="stat-card">
          <span class="stat__num">0</span>
          <span class="stat__label">Supplements pushed</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── EMAIL CTA ─────────────────────────────────────────────── -->
  <section class="section cta-section" id="subscribe">
    <div class="section__inner cta__inner">
      <span class="eyebrow">Free Weekly Brief</span>
      <h2 class="section__title">Join the NeuroPulse list</h2>
      <p class="cta__sub">One email, once a week. The latest neuroscience distilled into one habit you can act on immediately. No filler, unsubscribe anytime.</p>
      <div class="cta__form-wrap">
        <LeadMagnet />
      </div>
    </div>
  </section>
</BaseLayout>


<style>
  /* ── Shared layout ───────────────────────────────────── */
  .section {
    padding: 5rem 2rem;
  }
  .section__inner {
    max-width: 960px;
    margin: 0 auto;
  }
  .eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--amber);
    margin: 0 0 0.75rem;
  }
  .section__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.6rem);
    font-weight: 800;
    color: var(--text);
    margin: 0 0 2.5rem;
    line-height: 1.2;
  }

  /* ── Hero ────────────────────────────────────────────── */
  .hero {
    padding: 6rem 2rem 4rem;
    background: radial-gradient(ellipse 70% 60% at 50% 0%, rgba(76, 224, 210, 0.06) 0%, transparent 70%);
    border-bottom: 1px solid var(--border);
  }
  .hero__inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }
  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 900;
    line-height: 1.15;
    color: var(--text);
    margin: 0 0 1.5rem;
    background: linear-gradient(135deg, var(--text) 40%, var(--cyan));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero__subtitle {
    font-size: clamp(1rem, 2.5vw, 1.2rem);
    color: var(--text-dim);
    line-height: 1.7;
    max-width: 600px;
    margin: 0 auto;
  }

  /* ── Mission ─────────────────────────────────────────── */
  .mission {
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .mission__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }
  .mission__card {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem 1.75rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .mission__card:hover {
    border-color: rgba(76, 224, 210, 0.35);
    transform: translateY(-3px);
  }
  .mission__icon {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: rgba(76, 224, 210, 0.08);
    border: 1px solid rgba(76, 224, 210, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cyan);
    margin-bottom: 1rem;
  }
  .mission__card h3 {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 0.75rem;
  }
  .mission__card p {
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.7;
    margin: 0;
  }

  /* ── Author ──────────────────────────────────────────── */
  .author-section {
    background: var(--bg-elev);
    border-bottom: 1px solid var(--border);
  }
  .author-card {
    display: flex;
    gap: 3rem;
    align-items: flex-start;
    background: var(--bg);
    border: 1px solid var(--border);
    border-left: 3px solid var(--cyan);
    border-radius: var(--radius);
    padding: 2.5rem 2rem;
  }
  .author-card__left {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
    min-width: 120px;
  }
  .author__avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: rgba(76, 224, 210, 0.1);
    border: 2px solid rgba(76, 224, 210, 0.3);
    color: var(--cyan);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
  }
  .author__meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    text-align: center;
  }
  .author__name {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--text);
    font-size: 1rem;
  }
  .author__role {
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--text-dim);
    text-align: center;
  }
  .author-card__bio p {
    color: var(--text-dim);
    line-height: 1.8;
    margin: 0 0 1rem;
    font-size: 0.975rem;
  }
  .author-card__bio p:last-of-type {
    margin-bottom: 1.25rem;
  }
  .author__tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .tag {
    font-size: 0.75rem;
    color: var(--text-dim);
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.2rem 0.5rem;
  }

  /* ── Values ──────────────────────────────────────────── */
  .values-section {
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .values__inner {
    display: grid;
    grid-template-columns: 1fr minmax(200px, 280px);
    gap: 4rem;
    align-items: start;
  }
  .values__list {
    list-style: none;
    counter-reset: vals;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .values__list li {
    counter-increment: vals;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    color: var(--text-dim);
    line-height: 1.7;
    font-size: 0.975rem;
  }
  .values__list li::before {
    content: "0" counter(vals);
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--amber);
    flex-shrink: 0;
    padding-top: 0.15em;
  }
  .values__list strong {
    color: var(--text);
  }
  .values__stat-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .stat-card {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    transition: border-color 0.2s ease;
  }
  .stat-card:hover {
    border-color: rgba(76, 224, 210, 0.35);
  }
  .stat__num {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 900;
    color: var(--cyan);
    line-height: 1;
  }
  .stat__label {
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  /* ── CTA ─────────────────────────────────────────────── */
  .cta-section {
    background: var(--bg-elev);
  }
  .cta__inner {
    text-align: center;
  }
  .cta__inner .eyebrow {
    justify-content: center;
    display: block;
  }
  .cta__sub {
    color: var(--text-dim);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 520px;
    margin: 0 auto 2rem;
  }
  .cta__form-wrap {
    max-width: 560px;
    margin: 0 auto;
    text-align: left;
  }

  /* ── Responsive ──────────────────────────────────────── */
  @media (max-width: 768px) {
    .section { padding: 3.5rem 1.25rem; }
    .hero { padding: 4rem 1.25rem 3rem; }

    .author-card {
      flex-direction: column;
      gap: 1.75rem;
    }
    .author-card__left {
      flex-direction: row;
      min-width: auto;
      align-items: center;
      text-align: left;
    }
    .author__meta { align-items: flex-start; text-align: left; }

    .values__inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .values__stat-stack {
      flex-direction: row;
      flex-wrap: wrap;
    }
    .stat-card { flex: 1 1 130px; }
  }
</style>
