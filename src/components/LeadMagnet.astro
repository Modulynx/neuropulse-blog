---
// LeadMagnet.astro — inline email opt-in.
// Replaces [INSERT_LEAD_MAGNET]. Placed after the mechanism section,
// the article's peak-engagement point.
//
// Design intent: reads as a "field note" pulled from the article, not a
// banner ad. Cyan hairline + mono eyebrow ties it to the neuroscience
// subject; the single magenta button is the only high-chroma element,
// so the eye goes straight to the one action.
//
// The <form> posts to your existing ESP endpoint — no client JS, so it
// costs nothing on Core Web Vitals. Swap ACTION for your real endpoint.
const ACTION = "https://app.kit.com/forms/9647814/subscriptions";
---

<aside class="lm" aria-label="Free guide sign-up">
  <p class="lm__eyebrow">Free guide</p>
  <h2 class="lm__title">The Brain Owner’s Manual</h2>
  <p class="lm__copy">
    A short PDF on focus, sleep and stress, with the study behind each habit.
    We send it by email. No spam, unsubscribe anytime.
  </p>
  <form class="lm__form" action={ACTION} method="POST">
    <label class="lm__label" for="lm-email">Email address</label>
    <div class="lm__row">
      <input
        class="lm__input"
        id="lm-email"
        type="email"
        name="email_address"
        placeholder="you@email.com"
        required
        autocomplete="email"
      />
      <button class="lm__btn" type="submit">Send it to me</button>
    </div>
  </form>
  <!--
    Post-submit redirect to /thank-you/: this form posts directly to Kit
    (app.kit.com), so there's no client-side hook to redirect from after
    submission — the browser just follows Kit's response.
    Configure the redirect in Kit itself instead:
      Kit dashboard → this Form → Settings → Success message →
      "Redirect to a URL" → https://neuropulse-blog.vercel.app/thank-you/
    Until that's set in Kit, subscribers will see Kit's default success
    message rather than our /thank-you/ page.
  -->
</aside>

<style>
  .lm { margin: 0; padding: 1.4rem 1.25rem; background: var(--bg-elev); border: 1px solid var(--border); border-radius: var(--radius); }
  .lm__eyebrow { font-size: 0.875rem; font-weight: 650; color: var(--amber); margin: 0 0 0.35rem; }
  .lm__title { font-family: var(--font-display); font-size: 1.35rem; margin: 0 0 0.4rem; }
  .lm__copy { color: var(--text-dim); font-size: 0.9375rem; line-height: 1.55; margin: 0 0 1rem; max-width: 60ch; }
  .lm__label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .lm__row { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .lm__input { flex: 1 1 220px; min-width: 0; padding: 0.75rem 0.85rem; background: #fff; border: 1px solid #8C857A; border-radius: var(--radius); color: var(--text); font: inherit; }
  .lm__input::placeholder { color: #6B655C; }
  .lm__btn { flex: 0 0 auto; padding: 0.75rem 1.25rem; background: var(--magenta); color: #fff; font: 600 1rem/1 var(--font-body); border: none; border-radius: var(--radius); cursor: pointer; }
  .lm__btn:hover { filter: brightness(0.92); }
  @media (max-width: 480px) { .lm__btn { flex: 1 1 100%; } }
</style>
