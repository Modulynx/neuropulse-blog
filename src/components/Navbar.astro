---
// Navbar.astro — sticky navigation header
// Design refresh 2026-11-17: paper background, serif name, plain links, one outlined quiz button.
// Behavior: a hairline appears under the bar once the page scrolls (IntersectionObserver trick).

const navLinks = [
  { label: "Blog", href: "/blog/" },
  { label: "Protocol", href: "/protocol/" },
  { label: "Tools", href: "/tools/" },
  { label: "About", href: "/about/" },
];
---

<header class="nav" id="site-nav">
  <div class="nav__inner">
    <!-- Logo -->
    <a class="nav__logo" href="/" aria-label="NeuroPulse Home">
      <span class="nav__logo-text">NeuroPulse</span>
    </a>

    <!-- Desktop Nav -->
    <nav class="nav__links" aria-label="Main navigation">
      {navLinks.map(link => (
        <a class="nav__link" href={link.href}>{link.label}</a>
      ))}
      <a class="nav__cta" href="/quiz/" id="nav-cta">Take the quiz</a>
    </nav>

    <!-- Mobile hamburger -->
    <button class="nav__burger" id="nav-burger" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-mobile">
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div class="nav__mobile" id="nav-mobile" aria-hidden="true">
    {navLinks.map(link => (
      <a class="nav__mobile-link" href={link.href}>{link.label}</a>
    ))}
    <a class="nav__mobile-cta" href="/quiz/">Take the quiz</a>
  </div>
</header>

<script>
  // Scroll: add glass effect
  const nav = document.getElementById('site-nav');
  const observer = new IntersectionObserver(
    ([e]) => nav?.classList.toggle('nav--scrolled', e.intersectionRatio < 1),
    { threshold: [1], rootMargin: '-1px 0px 0px 0px' }
  );
  if (nav) observer.observe(nav);

  // Mobile toggle
  const burger = document.getElementById('nav-burger');
  const mobileMenu = document.getElementById('nav-mobile');
  burger?.addEventListener('click', () => {
    const isOpen = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!isOpen));
    mobileMenu?.setAttribute('aria-hidden', String(isOpen));
    mobileMenu?.classList.toggle('nav__mobile--open', !isOpen);
    burger.classList.toggle('nav__burger--open', !isOpen);
  });
</script>

<style>
  .nav { position: sticky; top: 0; z-index: 100; background: var(--bg); border-bottom: 1px solid transparent; }
  .nav--scrolled { border-bottom-color: var(--border); }
  .nav__inner { max-width: 1040px; margin: 0 auto; padding: 0 16px; height: 60px; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .nav__logo { text-decoration: none; flex-shrink: 0; }
  .nav__logo-text { font-family: var(--font-display); font-weight: 700; font-size: 1.3rem; color: var(--text); letter-spacing: -0.01em; }
  .nav__links { display: flex; align-items: center; gap: 0.25rem; }
  .nav__link { font-size: 0.9375rem; font-weight: 500; color: var(--text); text-decoration: none; padding: 0.5rem 0.7rem; }
  .nav__link:hover { text-decoration: underline; text-decoration-color: var(--cyan); }
  .nav__cta { font-size: 0.9375rem; font-weight: 600; color: var(--text); text-decoration: none; padding: 0.45rem 0.9rem; border: 1.5px solid var(--text); border-radius: var(--radius); margin-left: 0.5rem; white-space: nowrap; }
  .nav__cta:hover { background: var(--text); color: var(--bg); }

  .nav__burger { display: none; flex-direction: column; gap: 5px; padding: 10px 8px; background: none; border: none; cursor: pointer; }
  .nav__burger span { display: block; width: 22px; height: 2px; background: var(--text); transition: transform 0.2s ease, opacity 0.2s ease; }
  .nav__burger--open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav__burger--open span:nth-child(2) { opacity: 0; }
  .nav__burger--open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .nav__mobile { display: none; flex-direction: column; padding: 0.5rem 16px 1rem; border-top: 1px solid var(--border); background: var(--bg); }
  .nav__mobile--open { display: flex; }
  .nav__mobile-link { font-size: 1rem; font-weight: 500; color: var(--text); text-decoration: none; padding: 0.8rem 0; border-bottom: 1px solid var(--border); }
  .nav__mobile-cta { font-size: 1rem; font-weight: 600; color: var(--cyan); padding: 0.8rem 0; }

  @media (max-width: 640px) {
    .nav__links { display: none; }
    .nav__burger { display: flex; }
  }
</style>
