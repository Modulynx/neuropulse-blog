---
// Footer.astro — design refresh 2026-11-17: plain footer, what we do in one line, links. No emoji, no gradient.
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner">
    <p class="footer__about"><span class="footer__logo">NeuroPulse</span> explains one brain study at a time. Every claim links to its paper. Educational content, not medical advice.</p>
    <nav class="footer__nav" aria-label="Footer navigation">
      <a class="footer__link" href="/blog/">All articles</a>
      <a class="footer__link" href="/about/">About</a>
      <a class="footer__link" href="/rss.xml">RSS</a>
      <a class="footer__link" href="/privacy/">Privacy</a>
    </nav>
    <p class="footer__copy">© {year} NeuroPulse</p>
  </div>
</footer>

<style>
  .footer { margin-top: auto; border-top: 1px solid var(--border); background: var(--bg); }
  .footer__inner { max-width: 760px; margin: 0 auto; padding: 2rem 16px 2.5rem; font-size: 0.9375rem; color: var(--text-dim); }
  .footer__about { margin: 0 0 0.9rem; line-height: 1.55; max-width: 60ch; }
  .footer__logo { font-family: var(--font-display); font-weight: 700; color: var(--text); }
  .footer__nav { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; margin-bottom: 0.9rem; }
  .footer__link { color: var(--text); }
  .footer__copy { margin: 0; font-size: 0.875rem; }
</style>
