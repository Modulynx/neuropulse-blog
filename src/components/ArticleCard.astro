---
// ArticleCard.astro — editorial magazine card
// Clean, human, warm dark — no AI scan-lines or code-style labels.

interface Props {
  title: string;
  slug: string;
  description: string;
  niche?: string;
  pubDate: Date;
  tags: string[];
  heroImage?: string;
  readingTime?: number;
}
const { title, slug, description, niche = "Neuroscience", pubDate, tags, heroImage, readingTime } = Astro.props;
const href = `/blog/${slug}/`;
const dateLabel = pubDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
const nicheLabel = niche.replace(/-/g, " ");
---

<article class="card">
  <a class="card__media-link" href={href} tabindex="-1" aria-hidden="true">
    <div class="card__media">
      {heroImage ? (
        <img class="card__img" src={heroImage} alt="" loading="lazy" decoding="async" width="640" height="360" />
      ) : (
        <div class="card__placeholder">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96-.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 1.98-3A2.5 2.5 0 0 1 9.5 2Z"/>
            <path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96-.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-1.98-3A2.5 2.5 0 0 0 14.5 2Z"/>
          </svg>
        </div>
      )}
    </div>
  </a>

  <div class="card__body">
    <span class="card__tag">{nicheLabel}</span>
    <h2 class="card__title">
      <a class="card__link" href={href}>{title}</a>
    </h2>
    <p class="card__snippet">{description}</p>

    <div class="card__foot">
      <time class="card__date" datetime={pubDate.toISOString()}>{dateLabel}</time>
      {typeof readingTime === "number" && (
        <span class="card__read-time">{readingTime} min read</span>
      )}
      <span class="card__more">
        Read →
      </span>
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .card:hover {
    border-color: #444;
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
  }

  /* Media */
  .card__media-link { display: block; }
  .card__media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-elev-2);
  }
  .card__img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    transition: transform 0.4s ease;
  }
  .card:hover .card__img { transform: scale(1.03); }
  .card__placeholder {
    width: 100%; height: 100%;
    display: grid; place-items: center;
    background: var(--bg-elev-2);
    color: var(--border);
  }

  /* Body */
  .card__body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.1rem 1.15rem 1.2rem;
    flex: 1;
  }

  /* Category tag — warm amber, not cyan (cyan = AI/tech) */
  .card__tag {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--amber);
    background: rgba(245,158,11,0.1);
    border: 1px solid rgba(245,158,11,0.2);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    width: fit-content;
  }

  .card__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
  }
  .card__link {
    color: var(--text);
    text-decoration: none;
  }
  .card__link::after { content: ""; position: absolute; inset: 0; }
  .card:hover .card__link { color: #fff; }

  .card__snippet {
    color: var(--text-dim);
    font-size: var(--step--1);
    line-height: 1.65;
    margin: 0;
    flex: 1;
    /* Clamp to 3 lines on mobile for cleanliness */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card__foot {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .card__date {
    font-family: var(--font-body);
    font-size: var(--step--1);
    color: var(--text-dim);
  }
  .card__read-time {
    font-size: var(--step--1);
    color: var(--text-dim);
  }
  .card__more {
    margin-left: auto;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--step--1);
    color: var(--cyan);
    white-space: nowrap;
  }
</style>
