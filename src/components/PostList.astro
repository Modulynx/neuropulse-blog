---
// PostList.astro — a plain list of articles: date + title + one line. No cards, no images.
import { estimateReadingMinutes } from "../utils/readingTime";
interface Props { posts: any[]; headingLevel?: 2 | 3; }
const { posts, headingLevel = 2 } = Astro.props;
const fmt = (d: Date) => new Intl.DateTimeFormat("en-US", { year: "numeric", month: "short", day: "numeric" }).format(d);
const H = `h${headingLevel}`;
---
<ol class="plist">
  {posts.map((p) => (
    <li class="plist__item">
      <p class="plist__meta"><time datetime={p.data.pubDate.toISOString()}>{fmt(p.data.pubDate)}</time> · {estimateReadingMinutes(p.body ?? "")} min read</p>
      <H class="plist__title"><a href={`/blog/${p.id}/`}>{p.data.title}</a></H>
      <p class="plist__line">{p.data.description}</p>
    </li>
  ))}
</ol>
<style>
  .plist { list-style: none; margin: 0; padding: 0; }
  .plist__item { padding: 1.35rem 0; border-top: 1px solid var(--border); }
  .plist__item:last-child { border-bottom: 1px solid var(--border); }
  .plist__meta { margin: 0 0 0.3rem; font-size: 0.875rem; color: var(--text-dim); }
  .plist__title { margin: 0 0 0.35rem; font-size: clamp(1.2rem, 1.1rem + 0.4vw, 1.4rem); line-height: 1.3; }
  .plist__title a { color: var(--text); text-decoration: none; }
  .plist__title a:hover { text-decoration: underline; text-decoration-color: var(--cyan); }
  .plist__line { margin: 0; font-family: var(--font-serif); font-size: 1.0625rem; line-height: 1.55; color: var(--text-dim); max-width: 68ch; }
</style>
