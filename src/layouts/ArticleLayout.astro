---
// ArticleLayout.astro — page shell: head, meta, schema, fonts.
// Fonts: self-hosted (design refresh 2026-11-17) — no Google Fonts request from the browser
import "@fontsource-variable/source-serif-4/opsz.css";
import "@fontsource-variable/source-serif-4/opsz-italic.css";
import "@fontsource-variable/inter/wght.css";
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Analytics from "../components/Analytics.astro";

interface Props {
  title: string;
  description: string;
  slug: string;
  author: string;
  pubDate: Date;
  tags: string[];
  videoUrl?: string;
  faq?: { q: string; a: string }[];
  image?: string;
  citation?: { title: string; url: string };
  noindex?: boolean;   // an unlisted article (src/utils/listed.ts): search engines leave it out, the page stays
}
const { title, description, slug, author, pubDate, tags, videoUrl, faq = [], image, citation, noindex = false } = Astro.props;

const SITE = "https://neuropulsemind.com";
const canonical = `${SITE}/blog/${slug}/`;
const isoDate = pubDate.toISOString();

// JSON-LD: Article + optional VideoObject + optional FAQPage
const graph: any[] = [
  {
    "@type": "Article",
    headline: title,
    description,
    datePublished: isoDate,
    dateModified: isoDate,
    author: { "@type": "Organization", name: "NeuroPulse", url: `${SITE}/about/` },
    publisher: { "@type": "Organization", name: "NeuroPulse" },
    mainEntityOfPage: canonical,
    keywords: tags.join(", "),
    ...(image ? { image: `${SITE}${image}` } : {}),
    ...(citation ? { citation: { "@type": "ScholarlyArticle", name: citation.title, url: citation.url } } : {}),
  },
];
if (videoUrl) {
  graph.push({
    "@type": "VideoObject",
    name: title,
    description,
    uploadDate: isoDate,
    contentUrl: videoUrl,
    thumbnailUrl: `${SITE}/og/${slug}.jpg`,
  });
}
if (faq.length) {
  graph.push({
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  });
}
const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": graph });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · NeuroPulse</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="article:author" content={author} />
    <meta property="article:published_time" content={isoDate} />
    {image && <meta property="og:image" content={`${SITE}${image}`} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <link rel="alternate" type="application/rss+xml" title="NeuroPulse" href="/rss.xml" />


    <script type="application/ld+json" set:html={jsonLd} />

    <!-- Analytics: Umami Cloud + funnel events (src/components/Analytics.astro); this layout does not wrap BaseLayout -->
    <Analytics />
  </head>
  <body>
    <Navbar />
    <slot />
    <Footer />
  </body>
</html>
